{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "cd frontend_react && npm ci",
  "buildCommand": "cd frontend_react && npm run build",
  "outputDirectory": "frontend_react/dist",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index"
    }
  ],
  "functions": {
    "api/index.py": {
      "maxDuration": 60,
      "includeFiles": "{backend/**,data/raw/catalogo_ofertas_entrega.csv,data/processed/demo/**}"
    }
  }
}
