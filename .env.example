# Configuración de Inteligencia Artificial (Gemini API)
# Coloca aquí tu clave de API obtenida en Google AI Studio (https://aistudio.google.com/)
GEMINI_API_KEY=tu_gemini_api_key_aqui

# Modelo a utilizar (por defecto gemini-1.5-flash o gemini-2.0-flash)
GEMINI_MODEL=gemini-1.5-flash

# Configuración de OpenRouter (Opcional - Sistema Cascada)
# Coloca aquí tu clave de API obtenida en OpenRouter (https://openrouter.ai/)
OPENROUTER_API_KEY=tu_openrouter_api_key_aqui
