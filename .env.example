# Configuración de Inteligencia Artificial (Gemini API)
# Coloca aquí tu clave de API obtenida en Google AI Studio (https://aistudio.google.com/)
GEMINI_API_KEY=tu_gemini_api_key_aqui

# Modelo que encabeza la cascada. Verificados disponibles (ago-2026):
#   gemini-3.7-flash (flagship), gemini-3-flash-preview,
#   gemini-3.1-flash-lite (el mas rapido), gemini-flash-latest.
# NO usar gemini-2.5-flash ni gemini-1.5-flash: la API responde 404.
GEMINI_MODEL=gemini-3.7-flash

# Timeout por peticion. Los modelos "thinking" tardan entre 2 y 15 s;
# por debajo de ~30 s el analisis post-hoc degrada al motor heuristico.
GEMINI_TIMEOUT=45

# Reintentos ante 429/503 (picos de demanda de Google) antes de pasar
# al siguiente modelo de la cascada.
GEMINI_MAX_REINTENTOS=2

# Profundidad de razonamiento: low | high | minimal.
# "low" conserva la calidad del analisis con ~1/5 de la latencia.
GEMINI_THINKING_LEVEL=low

# Proveedor prioritario de la cascada: gemini | ollama | openrouter
# Con LLM_PRIORITY=ollama la demo corre 100% offline y sin consumir cuota.
LLM_PRIORITY=gemini

# ------------------------------------------------------------------
# LLM local (Ollama) — respaldo cuando se agota la cuota de Gemini
# ------------------------------------------------------------------
# Sin esto, agotada la cuota el analisis cae al motor heuristico. Con Ollama
# activo el respaldo sigue siendo un LLM real, corriendo en la maquina.
#   1) Instalar:  winget install Ollama.Ollama
#   2) Descargar: ollama pull qwen2.5:7b
# La cascada detecta el servicio sola; no hace falta tocar codigo.
OLLAMA_HABILITADO=true
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Modelo local. Si se deja vacio se elige automaticamente entre los descargados
# (prefiere qwen2.5 > llama3.1 > llama3.2 > mistral > gemma2 > phi).
# Para una RTX 3050 de 6 GB: qwen2.5:7b (~4.7 GB) o llama3.2:3b (~2 GB, mas rapido).
OLLAMA_MODEL=

# Un 7B cuantizado en GPU de 6 GB tarda ~12-15 s por analisis en caliente.
OLLAMA_TIMEOUT=180

# Cuanto se queda el modelo residente en VRAM tras un analisis.
# Cargarlo en frio cuesta ~60 s extra; con esto solo se paga una vez.
# Antes del pitch conviene llamar a POST /api/speech/precalentar-llm-local
OLLAMA_KEEP_ALIVE=30m

# Configuración de OpenRouter (Opcional - Sistema Cascada)
# Coloca aquí tu clave de API obtenida en OpenRouter (https://openrouter.ai/)
OPENROUTER_API_KEY=tu_openrouter_api_key_aqui

# Dataset completo de clientes (opcional).
# Si se omite, el backend usa data/raw/dataset_clientes.csv y, si no existe,
# la muestra real versionada en data/processed/demo/dataset_clientes_demo.csv.
NBO_CLIENTES_PATH=
